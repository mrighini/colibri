+/* The same operation order as the packed CPU-reference kernel above, but
+ * address the already uploaded row-major mirror. No weight transfer occurs. */
+void fp8_ref_matmul_resident_kernel(float*y,const uint8_t*w,const float*bscale,
+        const float*x,int rows,int cols,int tokens){
+    auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+    int t=item.get_local_id(2), o=item.get_group(2);
+    if(t>=tokens||o>=rows)return;
+    const float *xs=x+(long long)t*cols;
+    const uint8_t *wr=w+(long long)o*cols;
+    const float *scl=bscale+(long long)(o/128)*(cols/128);
+    float sum=0.f;
+    for(int base=0;base<cols;base+=128){
+        float sc=scl[base/128];
+        for(int i=base;i<base+128;i++){
+            float v=e4m3_dev(wr[i]);
+            sum=sum+xs[i]*v*sc;
+        }
+    }
+    y[(long long)t*rows+o]=sum;
+}
+
+extern "C" int dsv4_sycl_fp8_resident_ref(Dsv4CudaTensor *t,const float *bscale,
+        int row_offset,int rows,const float *x,int tokens,float *y) try {
+    if(!t||!t->w||!bscale||!x||!y||(t->fmt!=8&&t->fmt!=9)||
+       row_offset<0||row_offset%128||rows<1||rows>t->O||row_offset>t->O-rows||
+       t->I<1||t->I%128||tokens<1||tokens>1024)return 0;
+    Dev *c=ctx(t->device); if(!c)return 0;
+    const int cols=t->I;
+    size_t sb=(size_t)((rows+127)/128)*(cols/128)*sizeof(float),
+           xb=(size_t)tokens*cols*sizeof(float), yb=(size_t)tokens*rows*sizeof(float);
+    if(!ok(DSV4_CHECK(dsv4_sycl::select_device(t->device)),"select resident fp8 ref device")||
+       !buf((void**)&c->aux1,&c->aux1cap,sb)||!buf((void**)&c->p2,&c->p2cap,xb)||
+       !buf((void**)&c->p4,&c->p4cap,yb)||
+       !ok(DSV4_CHECK(dsv4_sycl::copy(*c->stream,c->aux1,bscale,sb)),"resident fp8 ref scales")||
+       !ok(DSV4_CHECK(dsv4_sycl::copy(*c->stream,c->p2,x,xb)),"resident fp8 ref input"))return 0;
+    int threads=tokens<32?32:((tokens+31)/32)*32;
+    if((size_t)threads>dsv4_sycl::max_work_group_size())return 0;
+    auto w=(const uint8_t*)t->w+(size_t)row_offset*cols;
+    auto *out=c->p4; const auto *sc=c->aux1; const auto *in=c->p2;
+    c->stream->submit([&](sycl::handler &h){
+        h.parallel_for(sycl::nd_range<3>(sycl::range<3>(1,1,rows)*sycl::range<3>(1,1,threads),
+                                         sycl::range<3>(1,1,threads)),
+                       [=](sycl::nd_item<3>){ fp8_ref_matmul_resident_kernel(out,w,sc,in,rows,cols,tokens); });
+    });
+    return ok(DSV4_CHECK(dsv4_sycl::copy(*c->stream,y,c->p4,yb)),"resident fp8 ref result") &&
+           ok(DSV4_CHECK(c->stream->wait_and_throw()),"resident fp8 ref sync");
+}
+catch(const std::exception &exc) { dsv4_sycl::report(exc);return 0; }
+catch(...) { dsv4_sycl::report("unknown exception");return 0; }
 
