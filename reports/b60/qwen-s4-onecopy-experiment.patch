+/* The tier's pinned staging slot has the exact destination layout. Copy both
+ * parts in one command, then convert only the weight bytes in place. */
+extern "C" int coli_sycl_slot_fill_s4_staged(int device, void *dst, const void *src, size_t nw, size_t ns) try {
+    DeviceContext *ctx = find_ctx(device);
+    if (!dst || !src || !nw || !ns || ns > (SIZE_MAX - nw) / sizeof(float) ||
+        nw > (size_t)UINT_MAX * 256 - 255 || !select_ctx(ctx)) return 0;
+    sycl::queue &q = dq();
+    q.memcpy(dst, src, nw + ns * sizeof(float));
+    uint8_t *nib = (uint8_t *)dst; const size_t n = nw;
+    q.parallel_for(sycl::nd_range<3>(sycl::range<3>(1, 1, (unsigned)((n + 255) / 256)) * sycl::range<3>(1, 1, 256),
+                                     sycl::range<3>(1, 1, 256)),
+                   [=](sycl::nd_item<3>) { offset_to_signed_s4(nib, n); });
+    q.wait_and_throw();
+    return 1;
+}
+catch (sycl::exception const &exc) { return sycl_caught(exc, "coli_sycl_slot_fill_s4_staged"); }
