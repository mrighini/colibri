+/* Compare the experimental resident reference with the existing packed
+ * reference, for full tensors, grouped row offsets, and decode/prefill. */
+#define COLI_SYCL 1
+#include "../../backend_cuda_dsv4.h"
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+int main(int argc, char **argv) {
+    if(argc!=4 || std::strcmp(argv[1],"--device") || std::strcmp(argv[2],"0"))return 64;
+    int rows=256,cols=256;
+    if(!std::strcmp(argv[3],"--native")){rows=2048;cols=4096;}
+    else if(std::strcmp(argv[3],"--tiny"))return 64;
+    const size_t n=(size_t)rows*cols, ns=(size_t)(rows/128)*(cols/128);
+    std::vector<uint8_t> row(n),packed(n),scale(ns,127);
+    std::vector<float> scales(ns),x((size_t)5*cols),oldout((size_t)5*rows),newout((size_t)5*rows);
+    uint32_t seed=1938187;
+    for(size_t i=0;i<n;i++){
+        seed=seed*1664525u+1013904223u; uint8_t v=(uint8_t)(seed>>24);
+        row[i]=(v&127)==127?(uint8_t)(v^1):v;
+    }
+    for(int o=0;o<rows;o++)for(int i=0;i<cols;i++)
+        packed[((size_t)(o/8)*cols+i)*8+o%8]=row[(size_t)o*cols+i];
+    for(size_t i=0;i<ns;i++)scales[i]=std::ldexp(1.0f,(int)(i%9)-4);
+    for(float &v:x){seed=seed*1664525u+1013904223u;v=((int)(seed>>16)-32768)*0.0000137f;}
+    int device=0; Dsv4CudaTensor *t=nullptr;
+    if(!dsv4_cuda_init(&device,1)||!dsv4_cuda_upload_fp8(&t,row.data(),scale.data(),rows,cols,device))return 1;
+    int fail=0;
+    for(int tokens : {1,5}) for(int part=0;part<3;part++) {
+        int start=part==0?0:(part-1)*(rows/2), count=part==0?rows:rows/2;
+        const uint8_t *wp=packed.data()+(size_t)start*cols;
+        const float *sp=scales.data()+(size_t)(start/128)*(cols/128);
+        if(!dsv4_cuda_fp8_ref_matmul(device,wp,sp,count,cols,1,x.data(),tokens,oldout.data()) ||
+           !dsv4_sycl_fp8_resident_ref(t,sp,start,count,x.data(),tokens,newout.data())){fail=1;break;}
+        size_t mismatch=0;
+        for(size_t i=0;i<(size_t)tokens*count;i++)
+            mismatch+=!std::isfinite(oldout[i])||std::memcmp(&oldout[i],&newout[i],sizeof(float))!=0;
+        std::printf("resident-ref rows=%d cols=%d offset=%d tokens=%d mismatches=%zu\n",count,cols,start,tokens,mismatch);
+        if(mismatch)fail=1;
+    }
+    if(dsv4_sycl_fp8_resident_ref(t,scales.data(),1,128,x.data(),1,newout.data()) ||
+       dsv4_sycl_fp8_resident_ref(t,scales.data(),rows,128,x.data(),1,newout.data()))fail=1;
+    dsv4_cuda_tensor_free(t); dsv4_cuda_shutdown();
+    std::printf("resident-ref %s\n",fail?"FAIL":"PASS"); return fail;
+}
