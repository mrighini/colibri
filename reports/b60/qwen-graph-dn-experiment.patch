+/* Experimental Qwen3.6/B60 shared-expert frame graph. This is a sandbox
+ * build: only the stable single-row, two-card host-routed path opts in. */
+namespace q36g = sycl::ext::oneapi::experimental;
+using Q36GraphMod = q36g::command_graph<q36g::graph_state::modifiable>;
+using Q36GraphExec = q36g::command_graph<q36g::graph_state::executable>;
+struct Q36GraphSig {
+    CcCtx *ctx;
+    const void *owner, *bufs[8], *tensors[4], *weights[4], *scales[4];
+    int gate, conv_off, dn_off, flags;
+};
+struct Q36GraphEntry { Q36GraphSig sig; Q36GraphExec *exec; };
+static Q36GraphEntry q36_graph_entries[80];
+static Q36GraphMod *q36_graph_recording;
+static Q36GraphSig q36_graph_active_sig;
+static int q36_graph_active_layer = -1, q36_graph_registered;
+static unsigned long long q36_graph_captures, q36_graph_replays, q36_graph_invalidations, q36_graph_errors;
+static unsigned long long q36_graph_dn_captures, q36_graph_dn_replays;
+
+static void q36_graph_report_at_exit() {
+    std::fprintf(stderr, "[SYCL graph experiment] captures=%llu replays=%llu invalidations=%llu errors=%llu\n",
+                 q36_graph_captures, q36_graph_replays, q36_graph_invalidations, q36_graph_errors);
+    std::fprintf(stderr, "[SYCL graph DN] captures=%llu replays=%llu\n", q36_graph_dn_captures, q36_graph_dn_replays);
+}
+/* Called only after the device queue has been drained before freeing buffers. */
+namespace {
+static void q36_graph_invalidate(CcCtx *c) {
+    int had = 0;
+    for (auto &entry : q36_graph_entries) if (entry.exec && entry.sig.ctx == c) {
+        delete entry.exec; entry.exec = nullptr; std::memset(&entry.sig, 0, sizeof entry.sig); had = 1;
+    }
+    if (had) q36_graph_invalidations++;
+}
+}
+
+extern "C" int coli_sycl_q36_shared_graph_clear(int device) {
+    CcCtx *c = ctx_of(device);
+    if (!c) return 1;
+    bool found = false;
+    for (const auto &entry : q36_graph_entries) found |= entry.exec && entry.sig.ctx == c;
+    if (!found) return 1;
+    try { c->stream->wait_and_throw(); q36_graph_invalidate(c); return 1; }
+    catch (const std::exception &e) {
+        std::fprintf(stderr, "[SYCL graph experiment] clear failed: %s\n", e.what());
+        q36_graph_errors++; return 0;
+    }
+}
+
+extern "C" int coli_sycl_q36_shared_graph_begin(
+    int device, int layer, const void *owner, CcBuf *h2, CcBuf *gs, CcBuf *us,
+    CcBuf *hs, CcBuf *ds, CcBuf *sgd, ColiCudaTensor *tg, ColiCudaTensor *tu,
+    ColiCudaTensor *td, ColiCudaTensor *gate, int use_gate) {
+    CcCtx *c = live();
+    if (!c || c->device != device || layer < 0 || layer >= 40 || !owner || coli_sycl_fprof_flag ||
+        coli_sycl_profile_for(device).pci_device_id != 0xe211 || q36_graph_recording) return 0;
+    const CcBuf *bufs[] = {h2, gs, us, hs, ds, sgd};
+    const size_t bytes[] = {2048 * sizeof(float), 512 * sizeof(float), 512 * sizeof(float),
+                            512 * sizeof(float), 2048 * sizeof(float), sizeof(float)};
+    ColiCudaTensor *tensors[] = {tg, tu, td, use_gate ? gate : nullptr};
+    Q36GraphSig sig; std::memset(&sig, 0, sizeof sig);
+    sig.ctx = c; sig.owner = owner; sig.gate = use_gate;
+    for (int k = 0; k < 6; k++) {
+        if (!bufs[k] || bufs[k]->dev != device || !bufs[k]->d || bufs[k]->bytes < bytes[k]) return 0;
+        sig.bufs[k] = bufs[k]->d;
+    }
+    for (int k = 0; k < 4; k++) {
+        if (!tensors[k]) { if (k < 3 || use_gate) return 0; continue; }
+        int fmt = -1, I = 0, O = 0, group = 0;
+        const void *w = nullptr; const float *sc = nullptr;
+        if (coli_cuda_tensor_device(tensors[k]) != device ||
+            !coli_cuda_tensor_shape(tensors[k], &fmt, &I, &O) ||
+            !coli_cuda_tensor_dev(tensors[k], &w, &sc, &group)) return 0;
+        if (k < 2 && !(fmt == 1 && I == 2048 && O == 512)) return 0;
+        if (k == 2 && !(fmt == 1 && I == 512 && O == 2048)) return 0;
+        if (k == 3 && !(fmt == 0 && I == 2048 && O == 1)) return 0;
+        sig.tensors[k] = tensors[k]; sig.weights[k] = w; sig.scales[k] = sc;
+    }
+    try {
+        const auto &dev = c->stream->get_device();
+        if (!(dev.has(sycl::aspect::ext_oneapi_graph) || dev.has(sycl::aspect::ext_oneapi_limited_graph))) return 0;
+        Q36GraphEntry &entry = q36_graph_entries[layer];
+        if (entry.exec && std::memcmp(&entry.sig, &sig, sizeof sig) != 0) {
+            c->stream->wait_and_throw(); q36_graph_invalidate(c);
+        }
+        if (entry.exec) {
+            c->stream->ext_oneapi_graph(*entry.exec);
+            q36_graph_replays++;
+            return 2;  // replay submitted on the chain's in-order queue
+        }
+        q36_graph_recording = new Q36GraphMod(c->stream->get_context(), dev);
+        q36_graph_recording->begin_recording(*c->stream);
+        q36_graph_active_sig = sig; q36_graph_active_layer = layer;
+        if (!q36_graph_registered) { std::atexit(q36_graph_report_at_exit); q36_graph_registered = 1; }
+        return 1;  // caller now records the regular shared-expert operations
+    } catch (const std::exception &e) {
+        std::fprintf(stderr, "[SYCL graph experiment] begin failed: %s\n", e.what());
+        delete q36_graph_recording; q36_graph_recording = nullptr; q36_graph_active_layer = -1;
+        q36_graph_errors++; return -1;
+    }
+}
