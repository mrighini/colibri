+    if (!c || c->device != device || layer < 0 || layer >= 40 || !owner || coli_sycl_fprof_flag ||
+        coli_sycl_profile_for(device).pci_device_id != 0xe211 || q36_graph_recording ||
+        std::getenv("COLI_CUDA_DNREC_MIN")) return 0;
+    const CcBuf *bufs[] = {nrm, qkvz, ab, prm, ring, cv, rec, dny};
+    const size_t bytes[] = {2048 * sizeof(float), 12288 * sizeof(float), 64 * sizeof(float),
+                            sizeof(float), 8192 * 3 * sizeof(float), 8192 * sizeof(float),
+                            32 * 128 * 128 * sizeof(float), 4096 * sizeof(float)};
