+    for (int k = 0; k < 8; k++) {
+        if (!bufs[k] || bufs[k]->dev != device || !bufs[k]->d || bufs[k]->bytes < bytes[k]) return 0;
+        sig.bufs[k] = bufs[k]->d;
+    }
+    for (int k = 0; k < 2; k++) {
+        int fmt = -1, I = 0, O = 0, group = 0;
+        const void *w = nullptr; const float *sc = nullptr;
+        if (!tensors[k] || coli_cuda_tensor_device(tensors[k]) != device ||
+            !coli_cuda_tensor_shape(tensors[k], &fmt, &I, &O) ||
+            !coli_cuda_tensor_dev(tensors[k], &w, &sc, &group)) return 0;
+        if (k == 0 && !(fmt == 1 && I == 2048 && O == 12288)) return 0;
+        if (k == 1 && !(fmt == 0 && I == 2048 && O == 64)) return 0;
+        sig.tensors[k] = tensors[k]; sig.weights[k] = w; sig.scales[k] = sc;
+    }
+    const int slot = 40 + layer;
+    try {
+        const auto &dev = c->stream->get_device();
+        if (!(dev.has(sycl::aspect::ext_oneapi_graph) || dev.has(sycl::aspect::ext_oneapi_limited_graph))) return 0;
+        Q36GraphEntry &entry = q36_graph_entries[slot];
+        if (entry.exec && std::memcmp(&entry.sig, &sig, sizeof sig) != 0) {
+            c->stream->wait_and_throw(); q36_graph_invalidate(c);
+        }
+        if (entry.exec) {
+            c->stream->ext_oneapi_graph(*entry.exec);
