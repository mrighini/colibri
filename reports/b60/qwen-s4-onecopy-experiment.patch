+/* The one-copy staged int4 upload must match the two-copy ABI byte for byte,
+ * preserve the source and leave the bytes beyond the slot untouched. */
+#define COLI_SYCL 1
+#include "../../backend_cuda.h"
+#include "../s4_staged.h"
+#include "sycl_test_args.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+static void need(bool ok, const char *what) {
+    if (!ok) { std::fprintf(stderr,"S4 staged FAIL: %s\n",what); std::exit(1); }
+}
+static void shape(int dev, size_t nw, size_t ns) {
+    const size_t bytes=nw+ns*sizeof(float), total=bytes+64;
+    auto *src=(uint8_t*)coli_cuda_host_alloc(dev,total);
+    auto *dst=(uint8_t*)coli_cuda_pipe_alloc(dev,total);
+    auto *control=(uint8_t*)coli_cuda_pipe_alloc(dev,total);
+    need(src&&dst&&control,"allocate");
+    std::vector<uint8_t> initial(total,0xa5), saved(total), got(total), old(total);
+    for(size_t i=0;i<total;i++)src[i]=(uint8_t)(i*17u+31u);
+    std::memcpy(saved.data(),src,total);
+    need(coli_cuda_pipe_upload(dev,dst,initial.data(),total),"initialize destination");
+    need(coli_cuda_pipe_upload(dev,control,initial.data(),total),"initialize control");
+    need(coli_sycl_slot_fill_s4_staged(dev,dst,src,nw,ns),"staged upload");
+    need(coli_cuda_slot_fill_s4(dev,control,src,nw,(float*)(control+nw),
+                                 (const float*)(src+nw),ns),"two-copy upload");
+    need(coli_cuda_pipe_download(dev,dst,got.data(),total),"download staged");
+    need(coli_cuda_pipe_download(dev,control,old.data(),total),"download control");
+    need(!std::memcmp(got.data(),old.data(),total),"matches original upload");
+    need(!std::memcmp(src,saved.data(),total),"source retained");
+    for(size_t i=0;i<nw;i++)need(got[i]==(uint8_t)(saved[i]^0x88),"weight conversion");
+    for(size_t i=nw;i<bytes;i++)need(got[i]==saved[i],"scales retained");
+    for(size_t i=bytes;i<total;i++)need(got[i]==0xa5,"slot tail retained");
+    coli_cuda_pipe_free(dev,control); coli_cuda_pipe_free(dev,dst); coli_cuda_host_free(dev,src);
+}
+int main(int argc,char **argv) {
+    int dev[1],n=sycl_test_devices(argc,argv,dev,1); if(n<0)return 0;
+    need(n==1&&coli_cuda_init(dev,n),"device init");
+    shape(dev[0],256,13); shape(dev[0],768,128); shape(dev[0],1572864,49152);
+    need(!coli_sycl_slot_fill_s4_staged(dev[0],nullptr,nullptr,256,1),"null refused");
+    need(!coli_sycl_slot_fill_s4_staged(dev[0],(void*)1,(void*)1,256,SIZE_MAX),"overflow refused");
+    coli_cuda_shutdown(); std::puts("S4 staged PASS"); return 0;
+}
