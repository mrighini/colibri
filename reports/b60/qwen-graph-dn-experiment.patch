+extern "C" int coli_sycl_q36_dn_graph_begin(
+    int device, int layer, const void *owner, CcBuf *nrm, CcBuf *qkvz, CcBuf *ab,
+    CcBuf *prm, CcBuf *ring, CcBuf *cv, CcBuf *rec, CcBuf *dny,
+    ColiCudaTensor *dnp, ColiCudaTensor *tab, int conv_off, int dn_off, int flags) {
